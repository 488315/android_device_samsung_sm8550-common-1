# SamsungParts
allow system_app vendor_sysfs_nightdim:file rw_file_perms;
allow system_app vendor_sysfs_fingerprint:file rw_file_perms;
allow system_app vendor_sysfs_fingerprint:dir r_dir_perms;
allow system_app vendor_sysfs_touchscreen_writable:file rw_file_perms;
allow system_app vendor_sysfs_touchscreen:file r_file_perms;
allow system_app vendor_sysfs_touchscreen:dir r_dir_perms;

# Allow S Pen HAL service to be found
hal_client_domain(system_app, hal_samsung_spen)

# Allow Settings to read mdnie sysfs (LiveDisplay color mode controller)
allow system_app vendor_sysfs_mdnie:dir r_dir_perms;
allow system_app vendor_sysfs_mdnie:file rw_file_perms;

# Samsung framework services used from SystemUI / system apps.
allow system_app aodmanager_service:service_manager find;
allow system_app seminput_device_service:service_manager find;
